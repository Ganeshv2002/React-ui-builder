            },
            {
              "type": "setState",
              "path": "drawerOpen",
              "value": false
            },
            {
              "type": "setState",
              "path": "confirmationOpen",
              "value": true
            }
          ],
          "closeConfirmation": [
            {
              "type": "setState",
              "path": "confirmationOpen",
              "value": false
            }
          ],
          "tickets": [
