{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "framewright"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "name": {
      "default": "Untitled project",
      "type": "string"
    },
    "theme": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "tokens": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string"
              },
              "value": {
                "$ref": "#/$defs/__schema0"
              }
            },
            "required": [
              "type",
              "value"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "name",
        "tokens"
      ],
      "additionalProperties": false
    },
    "pages": {
      "minItems": 1,
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "path": {
            "type": "string",
            "pattern": "^\\/.*"
          },
          "isHome": {
            "type": "boolean"
          },
          "layout": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/__schema1"
            }
          },
          "logic": {
            "type": "object",
            "properties": {
              "state": {
                "default": {},
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "$ref": "#/$defs/__schema0"
                }
              },
              "resources": {
                "default": {},
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "url": {
                      "type": "string",
                      "minLength": 1
                    },
                    "method": {
                      "default": "GET",
                      "type": "string",
                      "enum": [
                        "GET",
                        "POST",
                        "PUT",
                        "PATCH",
                        "DELETE"
                      ]
                    },
                    "headers": {
                      "default": {},
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {
                        "type": "string"
                      }
                    },
                    "body": {
                      "$ref": "#/$defs/__schema0"
                    },
                    "response": {
                      "default": "json",
                      "type": "string",
                      "enum": [
                        "json",
                        "text"
                      ]
                    }
                  },
                  "required": [
                    "url",
                    "method",
                    "headers",
                    "response"
                  ],
                  "additionalProperties": false
                }
              },
              "actions": {
                "default": {},
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "maxItems": 100,
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "string",
                            "const": "setState"
                          },
                          "path": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 160
                          },
                          "value": {
                            "$ref": "#/$defs/__schema0"
                          }
                        },
                        "required": [
                          "type",
                          "path",
                          "value"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "string",
                            "const": "request"
                          },
                          "resource": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 160
                          },
                          "assignTo": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 160
                          }
                        },
                        "required": [
                          "type",
                          "resource"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "string",
                            "const": "navigate"
                          },
                          "pageId": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 160
                          }
                        },
                        "required": [
                          "type",
                          "pageId"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "string",
                            "const": "validate"
                          },
                          "rules": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 160
                          }
                        },
                        "required": [
                          "type"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "string",
                            "const": "custom"
                          },
                          "handler": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 160
                          },
                          "args": {
                            "$ref": "#/$defs/__schema0"
                          }
                        },
                        "required": [
                          "type",
                          "handler"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  }
                }
              },
              "effects": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 160
                    },
                    "on": {
                      "type": "string",
                      "enum": [
                        "mount",
                        "change"
                      ]
                    },
                    "watch": {
                      "default": [],
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 160
                      }
                    },
                    "actions": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 160
                      }
                    }
                  },
                  "required": [
                    "id",
                    "on",
                    "watch",
                    "actions"
                  ],
                  "additionalProperties": false
                }
              },
              "validation": {
                "default": {},
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "field": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 160
                      },
                      "rule": {
                        "type": "string",
                        "enum": [
                          "required",
                          "email",
                          "minLength",
                          "maxLength",
                          "min",
                          "max"
                        ]
                      },
                      "value": {
                        "type": "number"
                      },
                      "message": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "field",
                      "rule"
                    ],
                    "additionalProperties": false
                  }
                }
              }
            },
            "required": [
              "state",
              "resources",
              "actions",
              "effects",
              "validation"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "name",
          "path",
          "layout"
        ],
        "additionalProperties": {
          "$ref": "#/$defs/__schema0"
        }
      }
    }
  },
  "required": [
    "format",
    "schemaVersion",
    "name",
    "theme",
    "pages"
  ],
  "additionalProperties": {
    "$ref": "#/$defs/__schema0"
  },
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    },
    "__schema1": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "contractVersion": {
          "default": 1,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "props": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema1"
          }
        },
        "bindings": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "events": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "enum": [
              "click",
              "change",
              "submit",
              "blur"
            ]
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            }
          }
        },
        "visibleWhen": {
          "$ref": "#/$defs/__schema0"
        }
      },
      "required": [
        "id",
        "type",
        "contractVersion",
        "props"
      ],
      "additionalProperties": {
        "$ref": "#/$defs/__schema0"
      }
    }
  }
}