{
  "name": "framewright-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:cleanup": "tsx src/db/cleanup.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.3.16",
    "@fastify/cookie": "11.1.2",
    "@fastify/helmet": "13.1.1",
    "@fastify/static": "10.1.5",
    "argon2": "0.44.0",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.5",
    "nodemailer": "10.0.13",
    "openid-client": "6.8.8",
    "pg": "8.23.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/nodemailer": "7.0.12",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "jose": "6.2.12",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
