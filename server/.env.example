NODE_ENV=development
HOST=127.0.0.1
PORT=3002
APP_ORIGIN=http://localhost:5173
# Development only. Set a postgresql:// URL in production.
DATABASE_URL=pglite://.data/postgres
# Replace with at least 32 random characters in deployment secret storage.
RATE_LIMIT_SECRET=development-only-rate-limit-key-do-not-use-in-production
MAIL_MODE=file
MAIL_FROM=hello@framewright.test
# MAIL_MODE=smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# Render free tier uses HTTPS email delivery:
# MAIL_MODE=resend
# RESEND_API_KEY=
# MAIL_FROM=verified-sender@your-domain.example
# Register this exact callback in Google Cloud:
# http://localhost:5173/api/v1/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
TRUST_PROXY=false
